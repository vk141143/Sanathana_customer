# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public Firebase client configuration used for customer sign-in and TTS ID tokens.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
# Optional:
# VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# Private Sarvam credential. Configure in the Netlify Functions environment for production.
# Never prefix this value with VITE_.
SARVAM_API_KEY=your_actual_api_key_here

# Firebase Admin verifies ID tokens issued to signed-in users.
# Configure as a server-side Netlify Function variable; match VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=your_firebase_project_id

# Optional: configure all four private variables for persistent audio cache objects in R2.
# When omitted, bounded per-function-instance memory caching is used.
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_r2_bucket_name

# Public API origin for other server-backed features using the Express API.
# Translation TTS uses the same-origin Netlify Function and does not use this setting.
# VITE_API_BASE_URL=

# Public Cloudflare R2 base URL used by pre-generated Sanskrit Sloka WAV playback.
# Keep this aligned with the Admin Panel's VITE_R2_PUBLIC_URL.
VITE_R2_PUBLIC_URL=https://pub-5ac331aed8ed455b8efc7bde5ffd54bf.r2.dev

# Optional comma-separated CORS allowlist for the Express API and Netlify TTS Function.
# Defaults include the Harved production origin and local development origins.
# HARVED_ALLOWED_ORIGINS=https://harved.netlify.app,http://localhost:3000

# Chant: server only. Never prefix the service key with VITE_.
# Copy these settings into .env.local and restart npm run dev after editing.
# All three Supabase settings must belong to the same project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

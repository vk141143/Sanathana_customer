# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required for server-side scripture translation audio.
SARVAM_API_KEY=your_actual_api_key_here

# Firebase Admin verifies the ID tokens issued to signed-in users.
# This must be the Firebase project ID used by VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=your_firebase_project_id

# Optional: configure all four variables to cache audio privately in Cloudflare R2.
# When omitted, audio is cached in bounded server memory and is lost on restart.
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=your_r2_bucket_name

# Public Express API origin used by the Netlify frontend.
# Set this in Netlify after deploying the backend; leave unset for same-origin local development.
# Example format only: https://your-service.onrender.com
# VITE_API_BASE_URL=

# Comma-separated CORS allowlist for the Express backend.
# The backend defaults to the Harved production origin and local development origins.
# HARVED_ALLOWED_ORIGINS=https://harved.netlify.app,http://localhost:3000

# Chant: server only. Never prefix the service key with VITE_.
# Copy these settings into .env.local and restart npm run dev after editing.
# All three Supabase settings must belong to the same project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# HTTPS public delivery origin for uploaded Chant assets (not the S3 API endpoint).
CLOUDFLARE_R2_PUBLIC_URL=https://your-media-domain.example
